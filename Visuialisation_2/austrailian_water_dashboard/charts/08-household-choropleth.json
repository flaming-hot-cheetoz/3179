{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "data/australian-states.geojson", "format": { "type": "json", "property": "features" } },
  "transform": [
    {
      "lookup": "properties.shapeName",
      "from": {
        "data": { "url": "data/state-map-values.csv", "format": { "type": "csv" } },
        "key": "region",
        "fields": ["household_use_kL"]
      },
      "as": ["household_use_kL"]
    }
  ],
  "width": "container",
  "height": 350,
  "projection": { "type": "mercator", "center": [134, -27], "scale": 430 },
  "mark": { "type": "geoshape", "stroke": "#fffefa", "strokeWidth": 1.5 },
  "encoding": {
    "color": { "field": "household_use_kL", "type": "quantitative", "title": "kL / household", "scale": { "scheme": "tealblues" } },
    "tooltip": [
      { "field": "properties.shapeName", "type": "nominal", "title": "State or territory" },
      { "field": "household_use_kL", "type": "quantitative", "title": "kL per household", "format": ",.1f" }
    ]
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": { "stroke": null },
    "legend": { "labelColor": "#647b79", "titleColor": "#647b79", "labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 11, "titleFontSize": 11 }
  }
}
