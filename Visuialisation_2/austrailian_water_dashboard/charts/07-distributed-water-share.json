{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "../australia_water_consumption.csv", "format": { "type": "csv" } },
  "transform": [
    { "filter": "datum.dataset === 'national_timeseries' && datum.metric === 'Distributed water use' && datum.year === '2023-24'" },
    { "calculate": "toNumber(datum.value)", "as": "use_GL" }
  ],
  "width": "container",
  "height": 280,
  "mark": { "type": "arc", "innerRadius": 68, "outerRadius": 110, "stroke": "#fffefa", "strokeWidth": 2 },
  "encoding": {
    "theta": { "field": "use_GL", "type": "quantitative", "stack": true },
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": "Sector",
      "sort": ["Agriculture, forestry and fishing", "Households", "Other industries", "Manufacturing", "Mining"],
      "scale": { "domain": ["Agriculture, forestry and fishing", "Households", "Other industries", "Manufacturing", "Mining"], "range": ["#155d56", "#238b7e", "#86bfa1", "#e98968", "#6d9da6"] }
    },
    "tooltip": [
      { "field": "sector", "type": "nominal", "title": "Sector" },
      { "field": "use_GL", "type": "quantitative", "title": "Use (GL)", "format": ",.0f" }
    ]
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": { "stroke": null },
    "legend": { "labelColor": "#647b79", "titleColor": "#647b79", "labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 10, "titleFontSize": 11 }
  }
}
