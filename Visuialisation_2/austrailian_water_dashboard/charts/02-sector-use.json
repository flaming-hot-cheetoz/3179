{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "../australia_water_consumption.csv", "format": { "type": "csv" } },
  "transform": [
    { "filter": "datum.dataset === 'national_timeseries' && datum.metric === 'Distributed water use'" },
    { "calculate": "toNumber(datum.value)", "as": "use_GL" }
  ],
  "width": "container",
  "height": 260,
  "mark": { "type": "area", "opacity": 0.82, "interpolate": "monotone" },
  "encoding": {
    "x": { "field": "year", "type": "ordinal", "sort": null, "title": null, "axis": { "labelAngle": 0, "labelOverlap": false } },
    "y": { "field": "use_GL", "type": "quantitative", "stack": "zero", "title": "Distributed water use (GL)" },
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": "Sector",
      "sort": ["Agriculture, forestry and fishing", "Households", "Other industries", "Manufacturing", "Mining"],
      "scale": { "domain": ["Agriculture, forestry and fishing", "Households", "Other industries", "Manufacturing", "Mining"], "range": ["#155d56", "#238b7e", "#86bfa1", "#e98968", "#6d9da6"] }
    },
    "tooltip": [
      { "field": "year", "type": "ordinal", "title": "Year" },
      { "field": "sector", "type": "nominal", "title": "Sector" },
      { "field": "use_GL", "type": "quantitative", "title": "Use (GL)", "format": ",.0f" }
    ]
  },
  "config": {
    "background": null,
    "font": "DM Sans",
    "view": { "stroke": null },
    "axis": { "labelColor": "#647b79", "titleColor": "#647b79", "gridColor": "#e9eeea", "domainColor": "#d9e2dc", "tickColor": "#d9e2dc", "labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 11, "titleFontSize": 11 },
    "legend": { "labelColor": "#647b79", "titleColor": "#647b79", "labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 11, "titleFontSize": 11 }
  }
}
